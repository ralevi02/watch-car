# Copia este archivo como .env para correr las pruebas en tu computador.
# En GitHub Actions estos valores van como "secrets" del repositorio.

# Gemini (Google AI Studio → Get API key). Con este nombre lo lee solo @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional. Proxy residencial, formato http://usuario:clave@host:puerto
PROXY_URL=

# Opcional. Token de una app de desarrollador de MercadoLibre.
ML_ACCESS_TOKEN=

# Opcional, solo para pruebas locales: ruta a un Chrome/Chromium propio.
BROWSER_EXECUTABLE=

# 1 = navegador sin ventana. En GitHub Actions se usa 0 con pantalla virtual (xvfb).
HEADLESS=0

# Supabase. La clave secreta sale de Project Settings → API Keys → Secret keys (solo worker/servidor).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Para la app (clave pública).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Notificaciones push (web-push). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# URL pública de la app (para los links de las notificaciones).
APP_URL=
