# Copia este archivo como .env para correr las pruebas en tu computador.
# En GitHub Actions estos valores van como "secrets" del repositorio.

# Opcional. Proxy residencial, formato http://usuario:clave@host:puerto
PROXY_URL=

# Opcional. Token de una app de desarrollador de MercadoLibre.
ML_ACCESS_TOKEN=

# Opcional, solo para pruebas locales: ruta a un Chrome/Chromium propio.
BROWSER_EXECUTABLE=

# 1 = navegador sin ventana. En GitHub Actions se usa 0 con pantalla virtual (xvfb).
HEADLESS=0
